<!--
  =============================================================================
  Golem Default Layout Template (skeleton.pt)
  =============================================================================

  This template defines the foundational HTML5 layout macro and METAL extension
  slots for Golem documentation portals. Custom themes can inherit or override
  individual slots using METAL macro expansion:

    <html metal:use-macro="default_layout">
      <head metal:fill-slot="head">...</head>
      <header metal:fill-slot="header">...</header>
      <aside metal:fill-slot="navigation">...</aside>
      <main metal:fill-slot="content">...</main>
      <aside metal:fill-slot="table-of-contents">...</aside>
      <footer metal:fill-slot="footer">...</footer>
    </html>

  METAL Slots Defined:
  ~~~~~~~~~~~~~~~~~~~~
  * metal:define-macro="layout"
      Top-level HTML document macro defining the page structure.
  * metal:define-slot="head"
      Document <head> metadata, custom CSS, Google Fonts, and syntax styling.
  * metal:define-slot="header"
      Site header bar displaying site title, branding, and author metadata.
  * metal:define-slot="navigation"
      Sidebar navigation panel supporting pre-rendered nav_html or tree iteration.
  * metal:define-slot="content"
      Main reading pane: breadcrumbs, page title, rendered body HTML, and pagination.
  * metal:define-slot="table-of-contents"
      Right-hand sidebar displaying on-page Table of Contents (toc_html).
  * metal:define-slot="footer"
      Page footer containing "Edit this page" source links and generator version.

  Template Context Variables:
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Core Engine Variables:
  * title (str): Active page heading extracted from document header.
  * site_title (str): Global site title from golem.toml / pyproject.toml.
  * site_author (str): Global author or organization name.
  * site_url (str | None): Canonical site root URL.
  * generator_version (str): Running Golem version string.
  * root_path (str): Relative path prefix back to site root.
  * current_path (str): Relative path of the source document.
  * body_html (str): Pre-rendered semantic HTML body content.
  * nav_tree (list[dict]): Hierarchical navigation tree items ({title, url, path, children}).
  * nav_html (str): Pre-rendered navigation HTML markup.
  * toc_html (str): Rendered unordered list of on-page headings.
  * prev_page (dict | None): Previous document link ({title, url}).
  * next_page (dict | None): Next document link ({title, url}).
  * custom_css (list[str]): External stylesheet URLs to inject.
  * custom_js (list[str]): External JavaScript URLs to inject.
  * pygments_css (str | None): Code syntax highlighting CSS rules.
  * body_class (str | None): CSS classes applied to <body>.
  * content_class (str | None): Additional CSS classes applied to <main>.

  Plugin-Injected Variables:
  * breadcrumbs (list[dict]): Hierarchical ancestor trail from root to current page.
      Item keys: title (str), url (str), is_current (bool).
      (Injected by 'nav_helpers' plugin)
  * source_edit_url (str | None): Canonical web URL to edit source file in git host.
      (Injected by 'source_links' plugin)
  * source_view_url (str | None): Canonical web URL to view raw source file.
      (Injected by 'source_links' plugin)
  * source_repo_url (str | None): Canonical web URL to the source repository.
      (Injected by 'source_links' plugin)
  * site_index (dict[str, dict]): Alphabetized index entries grouped by letter.
      (Injected by 'index' plugin on pages with :page-role: index)
  * site_glossary (dict[str, list[dict]]): Alphabetized glossary entries grouped by letter.
      (Injected by 'glossary' plugin on pages with :page-role: glossary)
  =============================================================================
-->
<!DOCTYPE html>
<html lang="en" metal:define-macro="layout">
<!-- METAL Slot: head - Document <head> metadata, custom CSS, and syntax styling -->
<head metal:define-slot="head">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${title} - ${site_title}</title>
    <meta name="generator" content="${generator_version}" />
    <meta tal:condition="site_author" name="author" content="${site_author}" />
    <link rel="canonical" tal:condition="site_url" href="${site_url}" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:ital,wght@0,300..900;1,300..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${root_path}static/css/golem.css" />
    <tal:block tal:repeat="css_file custom_css">
        <link rel="stylesheet" href="${css_file}" />
    </tal:block>
    <style tal:condition="pygments_css" tal:content="structure pygments_css"></style>
</head>
<body tal:attributes="class body_class or None">
    <a href="#golem-content" class="golem-skip-link">Skip to main content</a>
    <!-- METAL Slot: header - Branding, site title, logo, and top-level header content -->
    <header id="golem-header" class="golem-header" metal:define-slot="header">
        <h1><a href="./" tal:attributes="href site_url or root_path">${site_title}</a></h1>
        <span tal:condition="site_author" class="golem-author">${site_author}</span>
    </header>
    <div id="golem-wrapper">
        <!-- METAL Slot: navigation - Sidebar navigation layout, tree vs. custom HTML -->
        <aside id="golem-sidebar-left" class="golem-sidebar-left" aria-label="Site Navigation" metal:define-slot="navigation">
            <details class="golem-nav-details" open="open">
                <summary class="golem-nav-summary"><h3>Navigation</h3></summary>
                <div class="golem-nav-content">
                    <div tal:condition="nav_html" tal:replace="structure nav_html" />
                    <ul tal:condition="not:nav_html and nav_tree" class="golem-nav-list">
                        <li tal:repeat="item nav_tree" class="golem-nav-item">
                            <a href="${item.url}" tal:attributes="href item.url">${item.title}</a>
                        </li>
                    </ul>
                </div>
            </details>
        </aside>
        <!-- METAL Slot: content - Main article body, breadcrumbs, title, and sequential pagination -->
        <main id="golem-content" class="golem-content" metal:define-slot="content" tal:attributes="class ('golem-content ' + content_class).strip() if content_class else 'golem-content'">
            <tal:block tal:define="crumbs breadcrumbs | nothing">
                <nav tal:condition="python: crumbs and len(crumbs) > 1" aria-label="Breadcrumb" class="golem-breadcrumbs">
                    <ol>
                        <li tal:repeat="crumb crumbs" tal:attributes="aria-current python:'page' if (crumb.get('is_current') if isinstance(crumb, dict) else getattr(crumb, 'is_current', False)) else None">
                            <a tal:condition="python: not (crumb.get('is_current') if isinstance(crumb, dict) else getattr(crumb, 'is_current', False))" href="${crumb.url}" tal:attributes="href crumb.url">${crumb.title}</a>
                            <span tal:condition="python: (crumb.get('is_current') if isinstance(crumb, dict) else getattr(crumb, 'is_current', False))">${crumb.title}</span>
                        </li>
                    </ol>
                </nav>
            </tal:block>
            <h1 tal:condition="title">${title}</h1>
            <div tal:content="structure body_html" />
            <nav tal:condition="prev_page or next_page" class="golem-pagination" aria-label="Chapter Navigation">
                <a tal:condition="prev_page" href="${prev_page.url}" tal:attributes="href prev_page.url" class="golem-pagination-card golem-pagination-prev" rel="prev">
                    <span class="golem-pagination-subtitle">← Previous</span>
                    <span class="golem-pagination-title">${prev_page.title}</span>
                </a>
                <div tal:condition="not:prev_page" class="golem-pagination-spacer"></div>
                <a tal:condition="next_page" href="${next_page.url}" tal:attributes="href next_page.url" class="golem-pagination-card golem-pagination-next" rel="next">
                    <span class="golem-pagination-subtitle">Next →</span>
                    <span class="golem-pagination-title">${next_page.title}</span>
                </a>
            </nav>
        </main>
        <!-- METAL Slot: table-of-contents - On-page TOC sidebar -->
        <aside id="golem-sidebar-right" class="golem-sidebar-right golem-toc" metal:define-slot="table-of-contents">
            <h4>On This Page</h4>
            <div tal:content="structure toc_html" />
        </aside>
    </div>
    <!-- METAL Slot: footer - Footer links, copyright notice, and edit page link -->
    <footer id="golem-footer" class="golem-footer" metal:define-slot="footer">
        <div tal:condition="source_edit_url | nothing" class="golem-source-links">
            <a href="${source_edit_url}" tal:attributes="href source_edit_url" class="golem-edit-link" target="_blank" rel="noopener noreferrer">
                <svg class="icon-edit" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                <span>Edit this page</span>
            </a>
        </div>
        <p>Generated by Golem ${generator_version}</p>
    </footer>
    <script>
        (function() {
            var CHECK_ICON = '<svg class="icon-check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

            function copyToClipboard(text, done) {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(function() {
                        done(true);
                    }).catch(function() {
                        fallbackCopy(text, done);
                    });
                } else {
                    fallbackCopy(text, done);
                }
            }

            function fallbackCopy(text, done) {
                try {
                    var ta = document.createElement("textarea");
                    ta.value = text;
                    ta.style.position = "fixed";
                    ta.style.left = "-999999px";
                    ta.style.top = "-999999px";
                    document.body.appendChild(ta);
                    ta.focus();
                    ta.select();
                    var res = document.execCommand("copy");
                    document.body.removeChild(ta);
                    done(res);
                } catch (err) {
                    done(false);
                }
            }

            document.addEventListener("click", function(e) {
                var copyBtn = e.target.closest(".listing-copy-btn");
                if (copyBtn) {
                    var block = copyBtn.closest(".listingblock");
                    if (!block) return;
                    var checkedInput = block.querySelector('.tab-input:checked');
                    var activePane = checkedInput ? block.querySelector('.tab-pane[data-tab="' + checkedInput.value + '"]') : null;
                    if (!activePane) {
                        activePane = block.querySelector('.tab-pane') || block.querySelector('.listing-content');
                    }
                    var codeEl = activePane ? activePane.querySelector('pre code') : null;
                    if (!codeEl) {
                        // Fallback to source pane or any pane with code
                        codeEl = block.querySelector('.tab-pane[data-tab="source"] pre code') || block.querySelector('pre code');
                    }
                    if (!codeEl) return;

                    var clone = codeEl.cloneNode(true);
                    var conums = clone.querySelectorAll(".conum, i.conum");
                    for (var i = 0; i < conums.length; i++) {
                        conums[i].remove();
                    }
                    var text = clone.textContent;

                    copyToClipboard(text, function(success) {
                        if (!success) return;
                        if (copyBtn._copyTimeout) {
                            clearTimeout(copyBtn._copyTimeout);
                        }
                        if (!copyBtn._originalHtml) {
                            copyBtn._originalHtml = copyBtn.innerHTML;
                        }
                        var originalLabel = copyBtn.getAttribute("aria-label");
                        var originalTitle = copyBtn.getAttribute("title");

                        copyBtn.innerHTML = CHECK_ICON;
                        copyBtn.setAttribute("aria-label", "Copied!");
                        if (originalTitle) copyBtn.setAttribute("title", "Copied!");
                        copyBtn.classList.add("copied");

                        copyBtn._copyTimeout = setTimeout(function() {
                            copyBtn.innerHTML = copyBtn._originalHtml;
                            if (originalLabel) copyBtn.setAttribute("aria-label", originalLabel);
                            if (originalTitle) copyBtn.setAttribute("title", originalTitle);
                            copyBtn.classList.remove("copied");
                            copyBtn._copyTimeout = null;
                        }, 2000);
                    });
                }
            });
        })();
    </script>
    <tal:block tal:repeat="js_file custom_js">
        <script src="${js_file}"></script>
    </tal:block>
</body>
</html>
